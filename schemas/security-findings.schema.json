{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "findings": {
      "items": {
        "properties": {
          "affected_component": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "false_positive_considerations": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "id": {
            "pattern": "^NAR-SEC-[0-9]{3}$",
            "type": "string"
          },
          "potential_impact": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "reproduction": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "CONFIRMED",
              "STRONGLY_INDICATED",
              "POTENTIAL",
              "UNVERIFIED",
              "CONTRADICTED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "confidence",
          "affected_component",
          "file_path",
          "evidence",
          "explanation",
          "potential_impact",
          "reproduction",
          "remediation",
          "false_positive_considerations"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "checks_skipped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Check families that did not run because a sub-tool returned no result; an empty list means every family ran. Added in the 2.6.2 stability campaign (D-13): a skipped family must never read as a clean result."
    }
  },
  "required": [
    "findings"
  ],
  "title": "NAR security findings",
  "type": "object"
}
