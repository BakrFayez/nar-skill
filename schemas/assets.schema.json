{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "properties": {
  "assets": {
   "items": {
    "properties": {
     "category": {
      "type": "string"
     },
     "height": {
      "type": [
       "integer",
       "null"
      ]
     },
     "path": {
      "type": "string"
     },
     "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "size_bytes": {
      "minimum": 0,
      "type": "integer"
     },
     "source_archive": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "width": {
      "type": [
       "integer",
       "null"
      ]
     },
     "audio": {
      "type": "object"
     }
    },
    "required": [
     "path",
     "type",
     "category",
     "size_bytes",
     "sha256"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "duplicates": {
   "items": {
    "type": "object"
   },
   "type": "array"
  },
  "total_assets": {
   "minimum": 0,
   "type": "integer"
  },
  "total_bytes": {
   "minimum": 0,
   "type": "integer"
  }
 },
 "required": [
  "assets",
  "total_assets",
  "total_bytes"
 ],
 "title": "NAR asset inventory",
 "type": "object"
}