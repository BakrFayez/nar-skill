{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "description": "The engines.json document written by nar-engines (and cached per case). Every verdict carries its indicators; version and recommended_next are null when the engine has no recorded version or no deep-dive tool.",
 "properties": {
  "ambiguities": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "jni_scan": {
   "description": "Part 3.1 additive block: summary of the lib/**/*.so dynamic-export scan behind the verdicts' jni_symbols evidence.",
   "properties": {
    "anative_activity_oncreate": {
     "type": "boolean"
    },
    "libraries_scanned": {
     "minimum": 0,
     "type": "integer"
    },
    "libraries_with_exports": {
     "minimum": 0,
     "type": "integer"
    },
    "native_no_engine": {
     "type": "boolean"
    },
    "unknown_engine": {
     "description": "Field round additive flag: true when the target carries substantial native code with no detected engine and the verdicts carry an explicit Unknown / custom engine record instead of the plain-native label.",
     "type": "boolean"
    }
   },
   "type": "object"
  },
  "target": {
   "type": "string"
  },
  "target_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  },
  "tool": {
   "type": "string"
  },
  "verdicts": {
   "items": {
    "properties": {
     "confidence": {
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "type": "string"
     },
     "deep_dive": {
      "type": "object"
     },
     "detected": {
      "type": "boolean"
     },
     "engine": {
      "type": "string"
     },
     "indicators": {
      "items": {
       "properties": {
        "detail": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        }
       },
       "required": [
        "kind",
        "detail"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "jni_symbols": {
      "description": "Part 3.1 additive block: dynamic-symbol (JNI) evidence for this verdict, present only when the family's exported-symbol bar was met.",
      "properties": {
       "libraries": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "match_count": {
        "minimum": 1,
        "type": "integer"
       },
       "matched_symbols": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "strong_matches": {
        "minimum": 0,
        "type": "integer"
       },
       "weak_matches": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "matched_symbols",
       "match_count",
       "libraries"
      ],
      "type": "object"
     },
     "recommended_next": {
      "type": [
       "string",
       "null"
      ]
     },
     "unknown_engine": {
      "description": "Field round additive flag: true only on the explicit Unknown / custom engine verdict record emitted when substantial native code carries no known engine signatures.",
      "type": "boolean"
     },
     "score": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "version": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "engine",
     "detected",
     "confidence",
     "score",
     "version",
     "indicators",
     "recommended_next"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "version": {
   "type": "string"
  }
 },
 "required": [
  "tool",
  "version",
  "target",
  "target_sha256",
  "verdicts",
  "ambiguities"
 ],
 "title": "NAR engine detection verdicts",
 "type": "object"
}
