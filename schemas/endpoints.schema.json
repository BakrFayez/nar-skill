{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "properties": {
  "api_hosts": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "endpoints": {
   "items": {
    "properties": {
     "classification": {
      "enum": [
       "confirmed",
       "potential",
       "third-party",
       "unused-candidate",
       "sensitive",
       "unverified"
      ],
      "type": "string"
     },
     "host": {
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "redacted": {
      "type": "boolean"
     }
    },
    "required": [
     "url",
     "kind",
     "classification"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "hosts": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "network_libraries": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "services": {
   "items": {
    "type": "object"
   },
   "type": "array"
  },
  "redaction": {
   "type": "object",
   "properties": {
    "endpoint_values_redacted": {
     "type": "integer"
    },
    "policy": {
     "type": "string"
    }
   },
   "required": [
    "endpoint_values_redacted"
   ]
  }
 },
 "required": [
  "endpoints",
  "hosts"
 ],
 "title": "NAR network endpoints",
 "type": "object"
}