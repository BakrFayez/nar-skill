{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "description": "A runtime observation timeline for a case. nar-runtime's timeline-template emits the empty document ({case_id: null, device: null, events: []}); observation work fills events with the shape below.",
 "properties": {
  "case_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "device": {
   "properties": {
    "android": {
     "type": [
      "string",
      "null"
     ]
    },
    "model": {
     "type": [
      "string",
      "null"
     ]
    },
    "serial": {
     "type": "string"
    }
   },
   "type": [
    "object",
    "null"
   ]
  },
  "events": {
   "items": {
    "properties": {
     "evidence": {
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "enum": [
       "process-start",
       "process-exit",
       "network-connect",
       "network-request",
       "file-access",
       "crypto-op",
       "jni-call",
       "class-load",
       "ipc",
       "log",
       "note"
      ],
      "type": "string"
     },
     "source": {
      "type": [
       "string",
       "null"
      ]
     },
     "summary": {
      "type": "string"
     },
     "ts": {
      "type": "string"
     }
    },
    "required": [
     "ts",
     "kind",
     "summary"
    ],
    "type": "object"
   },
   "type": "array"
  }
 },
 "required": [
  "events"
 ],
 "title": "NAR runtime observation timeline",
 "type": "object"
}
