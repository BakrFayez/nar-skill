{"$schema":"http://json-schema.org/draft-07/schema#","definitions":{"entry":{"properties":{"chains":{"items":{"type":"string"},"type":"array"},"deep":{"type":["string","null"]},"ext":{"items":{"type":"string"},"type":"array"},"fidelity":{"enum":["source-equivalent","source-approximate","bytecode-listing","structural-summary","identified-only"]},"id":{"type":"string"},"name":{"type":"string"},"parser":{"type":"string"},"probe":{"type":["string","null"]},"reason":{"type":["string","null"]},"status":{"enum":["supported","partial","identified_only","unsupported","server_side"]},"test_ref":{"type":["string","null"]}},"required":["id","name","status","fidelity"],"type":"object"}},"description":"The coverage document generated from scripts/formats.json by nar-coverage.py (scripts/coverage.json and `nar coverage --json`). Single source of truth: formats.json; this schema validates the generated projection. Every entry carries exactly one status; a supported entry must carry a test_ref, and a non-supported entry must carry a reason and the cheapest probe that would raise its coverage.","properties":{"animation_systems":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"app_frameworks":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"asset_formats":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"engines":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"generated_from":{"const":"formats.json"},"input_types":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"protection_kinds":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"script_formats":{"items":{"$ref":"#/definitions/entry"},"type":"array"},"version":{"const":"1"}},"required":["version","generated_from","input_types","engines","asset_formats","script_formats","animation_systems","app_frameworks","protection_kinds"],"title":"NAR coverage matrix (Part 1 + Part 16)","type":"object"}